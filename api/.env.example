# Neon PostgreSQL — Transaction pooler (runtime queries)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL — Direct connection (prisma migrate)
DIRECT_URL="postgresql://user:password@ep-xxx.us-west-2.aws.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET="your-secret-here"

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:3000"

# Cloudflare R2
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
