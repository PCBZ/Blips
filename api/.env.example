# Neon PostgreSQL — Transaction pooler URL (port 6543)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech:6543/neondb?sslmode=require&pgbouncer=true"

# Neon PostgreSQL — Direct connection URL (port 5432, for prisma migrate)
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech:5432/neondb?sslmode=require"

# JWT secret
JWT_SECRET="your-secret-here"

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:3000"
